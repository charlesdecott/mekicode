# Copier vers .env (à la racine) et remplir.

# --- src/ et src_scratch/ (backend Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé par le harness Anthropic (défaut raisonnable)
MODEL_ID=claude-sonnet-4-6

# --- packages/mekillm (backend OpenRouter via SDK openai) ---
OPENROUTER_API_KEY=sk-or-...
MEKILLM_BASE_URL=https://openrouter.ai/api/v1
MEKILLM_MODEL=openai/gpt-4o-mini
# Optionnel : fichier de log JSONL des appels mekillm (vide = désactivé)
# MEKILLM_LOG_FILE=
