# Repos d'inspiration (non versionnés)
inspiration/

# Dépendances et artefacts
.understand-anything/wiki-viewer/node_modules/
.understand-anything/.trash-*/
__pycache__/
*.pyc

# Secrets et espace de travail de l'agent
.env
workspace/
.refactor-tmp/

# État runtime du harness src_scratch (sessions, mailboxes, tâches, mémoire)
.state/

# Logs d'appels mekillm (générés à l'exécution, à la racine)
.logs/

# Sessions de mekichat (générées à l'exécution, à la racine)
.sessions/

# Multi-projet : registre des projets + worktrees gérés (générés à l'exécution)
.mekicode/
.mekicode-worktrees/

# Trailer : artefacts lourds régénérables (on versionne seulement poster.png + preview.gif)
trailer/frames/
trailer/out/*.mp4

# NiceGUI (cache local)
.nicegui/

# Compagnon visuel brainstorming (ephemere)
.superpowers/

# worktrees gérés (générés à l'exécution)
.worktrees/
